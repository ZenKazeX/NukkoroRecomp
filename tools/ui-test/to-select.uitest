# Boot -> title -> main menu -> 1P GAME -> SELECT MODE, then settle on the
# stage-select screen and move the cursor so the selector, the panels and the
# info overlay can all be observed while they animate.
label boot-and-dialog
wait 260
press A 8
label logos-and-title
wait 640
press START 8
label main-menu
wait 200
press A 8
label mode-submenu
wait 200
press DOWN 6
wait 60
press A 8
label select-menu
wait 400
label navigate
press RIGHT 6
wait 90
press DOWN 6
wait 90
press LEFT 6
wait 90
press UP 6
wait 90
loop
