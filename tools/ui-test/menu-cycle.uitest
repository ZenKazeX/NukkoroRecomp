# Main menu -> 1P GAME submenu -> SELECT MODE -> back out, repeatedly.
#
# Covers the three menus whose left-side headings and grid/list compositions
# the widescreen layout has to keep stable, and it re-enters each of them so
# entry and exit animations are captured as well as the settled screens.
label boot-and-dialog
wait 260
press A 8
label logos-and-title
wait 640
press START 8
label main-menu
wait 240
label mode-submenu
press A 8
wait 240
press DOWN 6
wait 60
label select-menu
press A 8
wait 400
press RIGHT 6
wait 90
press DOWN 6
wait 90
label back-to-submenu
press B 8
wait 240
label back-to-main
press B 8
wait 240
loop
