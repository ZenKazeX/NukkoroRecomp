# Deterministic route to a SETTLED Story Mode menu: every press is followed by
# a long settle, and the script ends with no input at all, so any budget past
# the end lands with the game idle on the menu rather than mid-transition.
label boot-and-dialog
wait 260
press A 8
label logos-and-title
wait 640
press START 8
label main-menu
wait 200
press A 8
label story-menu-settle
wait 900
