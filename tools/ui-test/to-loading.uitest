# Boot -> SELECT MODE -> confirm a stage -> loading screen -> stage title -> gameplay.
label boot-and-dialog
wait 260
press A 8
label logos-and-title
wait 640
press START 8
label main-menu
wait 200
press A 8
label mode-submenu
wait 200
press DOWN 6
wait 60
press A 8
label select-menu
wait 400
label confirm-stage
press A 8
wait 120
press A 8
wait 120
press A 8
label loading
wait 1200
