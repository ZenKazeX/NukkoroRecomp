# Fade in / fade out, over and over.
#
# Every menu transition in the game runs through the one Fade singleton
# (0x80573E54, drawn by Fade::Draw 0x800448C8 as ten 64x480 Im2D columns), so
# walking into a submenu and straight back out again exercises a complete
# fade-out / fade-in pair per iteration. Use it to check that the curtain
# covers the full output width on every frame of the transition and that
# nothing drawn after the curtain inherits its group.
label boot-and-dialog
wait 260
press A 8
label logos-and-title
wait 640
press START 8
label main-menu
wait 200
label enter-submenu
press A 8
wait 260
label leave-submenu
press B 8
wait 260
loop
