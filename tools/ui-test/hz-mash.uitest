# Does ANY button reach the PAL 50/60 Hz screen? It polls through the
# RenderWare device layer (fn_80306d80 -> vtable+36 with request codes
# 12/6/8/20), not the game's usual pad path, so this checks the whole set.
wait 100
press A 10
wait 30
press B 10
wait 30
press START 10
wait 30
press DOWN 10
wait 30
press UP 10
wait 30
press LEFT 10
wait 30
press RIGHT 10
wait 30
press X 10
wait 30
press Y 10
wait 120
